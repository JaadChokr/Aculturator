{
  "name": "acculturator",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Acculturator v2 – plateforme interne d'acculturation (parcours Santé & Sécurité au Travail)",
  "workspaces": [
    "packages/*",
    "frontend/*",
    "mock-server"
  ],
  "scripts": {
    "dev": "npm run dev -w @acculturator/shell",
    "mock-server": "npm run start -w @acculturator/mock-server",
    "build": "npm run typecheck && npm run build -w @acculturator/shell",
    "build:demo": "npm run typecheck && npm run build:demo -w @acculturator/shell",
    "preview": "npm run preview -w @acculturator/shell",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write \"frontend/*/src/**/*.{ts,tsx,css}\" \"packages/*/src/**/*.{ts,tsx,css}\" \"mock-server/src/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
